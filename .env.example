# Copy to .env and fill in. Never commit .env. Secrets below are intentionally empty.

# --- API ---
NODE_ENV=development
PORT=3000
# postgres://user:pass@host:5432/db  or  pglite:./.data/db (zero-install dev mode)
DATABASE_URL=
# Comma-separated origins allowed by CORS (the app's own domain only).
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
SEED_DEMO=false

# Signing key for access tokens (32+ random characters).
JWT_SECRET=
# Key for Tony's message infrastructure (reminders endpoints only).
SERVICE_API_KEY=
# Key for the operator endpoints (/admin/*).
ADMIN_API_KEY=

# Tony's parse service (DeepSeek runs behind it; its key never reaches this app).
PARSE_SERVICE_URL=
PARSE_SERVICE_KEY=

# AI assistant. Claude (Anthropic) is the production model; no key = the built-in rule engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Local work and trials: DeepSeek or any OpenAI-compatible API. Used when ANTHROPIC_API_KEY is empty (not in
# production), or anywhere when AI_PROVIDER=openai.
AI_PROVIDER=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_API_KEY=

# --- website subscriptions (Stripe) and welcome e-mail (Resend) ---
# Public base URL of the website and app (on Render RENDER_EXTERNAL_URL is used when empty).
PUBLIC_URL=
# false = shops are only opened by subscribing on the website (production default).
ALLOW_SIGNUP=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
MAIL_FROM=
# Reminder sending (docs/hatirlatma-gonderimi.md). WhatsApp via Meta Cloud API, SMS via Twilio.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_DAY_BEFORE=
WHATSAPP_TEMPLATE_DAY_OF=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Square connection (docs/square-baglantisi.md). SQUARE_ENV: sandbox (default) or production.
SQUARE_APP_ID=
SQUARE_APP_SECRET=
SQUARE_ENV=
# Bank connection via Plaid (docs/banka-baglantisi.md). PLAID_ENV: sandbox (default) or production.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=
# Encrypts stored connection tokens (32+ characters; required in production with Square on).
CONNECTION_SECRET=
# Local only: print reminders instead of sending them.
SENDER_DRY_RUN=
# Operator alerts (docs/gozetim.md): an e-mail address and/or a Slack or Discord webhook URL. Empty = log only.
ALERT_EMAIL=
ALERT_WEBHOOK_URL=
# One server for everything: API under /api, website at /, app at /app/.
API_PREFIX=
SERVE_STATIC=

# --- docker compose ---
POSTGRES_USER=makas
POSTGRES_PASSWORD=
POSTGRES_DB=makas
APP_DOMAIN=localhost

# Staging only (docs/postgres-dogrulama.md): an external Postgres URL for the real-Postgres check. Never the live database.
STAGING_DATABASE_URL=
